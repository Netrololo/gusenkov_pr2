<Page x:Class="gusenkov_pr2.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gusenkov_pr2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task1Page">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="txtTaskDescription1" 
                       Text="Задача 1. Расчет частоты цифр." 
                       TextWrapping="Wrap" 
                       FontSize="14" 
                       FontWeight="Medium" 
                       Margin="0,0,0,15" 
                       Foreground="#333333"/>

            <Label Content="Введите целое число N (от 1 до 1000):" FontSize="12" Margin="0,0,0,2"/>
            <TextBox x:Name="tbInputData1" 
                     Width="250" 
                     HorizontalAlignment="Left" 
                     Height="28" 
                     Margin="0,0,0,15" 
                     VerticalContentAlignment="Center" 
                     FontSize="13"/>

            <Button x:Name="btnCalculate1" 
                    Content="Вычислить частоту цифр" 
                    Width="180" 
                    Height="32" 
                    HorizontalAlignment="Left" 
                    Margin="0,0,0,15" 
                    Click="btnCalculate1_Click"/>

            <Label Content="Результат анализа числа N^N:" FontSize="12" Margin="0,0,0,2"/>
            <TextBox x:Name="tbResultData1" 
                     Width="500" 
                     HorizontalAlignment="Left" 
                     Height="220" 
                     IsReadOnly="True" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto"
                     Background="#F9F9F9" 
                     Padding="5" 
                     FontSize="13" 
                     FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</Page>