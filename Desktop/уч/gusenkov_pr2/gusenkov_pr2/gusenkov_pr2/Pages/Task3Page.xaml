<Page x:Class="gusenkov_pr2.Pages.Task3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gusenkov_pr2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task3Page">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Задача 3. Определить максимальное количество одинаковых элементов в целочисленном массиве." TextWrapping="Wrap" FontSize="14" FontWeight="Medium" Margin="0,0,0,15"/>
            <Label Content="Введите элементы массива через пробел или запятую:"/>
            <TextBox x:Name="tbInputArray3" Width="450" HorizontalAlignment="Left" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
            <Button x:Name="btnProcess3" Content="Найти дубликаты" Width="150" Height="30" HorizontalAlignment="Left" Margin="0,0,0,15" Click="btnProcess3_Click"/>
            <Label Content="Результат анализа:"/>
            <TextBox x:Name="tbResult3" Width="450" HorizontalAlignment="Left" Height="100" IsReadOnly="True" TextWrapping="Wrap" Background="#F9F9F9"/>
        </StackPanel>
    </Grid>
</Page>