<Page x:Class="gusenkov_pr2.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gusenkov_pr2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task4Page">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Задача 4. Переставить элементы массива, чтобы суммы двух его частей отличались не более чем в 1,5 раза." TextWrapping="Wrap" FontSize="14" FontWeight="Medium" Margin="0,0,0,15"/>
            <Label Content="Массив по умолчанию (можно изменить):"/>
            <TextBox x:Name="tbInputArray4" Text="2 3 4 1 7 9 12 8 9 10" Width="450" HorizontalAlignment="Left" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
            <Button x:Name="btnProcess4" Content="Сбалансировать массив" Width="180" Height="30" HorizontalAlignment="Left" Margin="0,0,0,15" Click="btnProcess4_Click"/>
            <Label Content="Результат перестановки:"/>
            <TextBox x:Name="tbResult4" Width="450" HorizontalAlignment="Left" Height="150" IsReadOnly="True" TextWrapping="Wrap" Background="#F9F9F9" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</Page>