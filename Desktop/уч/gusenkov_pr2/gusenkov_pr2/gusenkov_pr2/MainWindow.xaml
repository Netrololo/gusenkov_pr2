<Window x:Class="gusenkov_pr2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gusenkov_pr2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF76E383">

            <TextBlock Text="Вариант 3" HorizontalAlignment="Center" VerticalAlignment="Center" 
           FontSize="20" FontWeight="Bold" Foreground="#333333"/>

            <Button x:Name="btnBack" HorizontalAlignment="Right" Content="Назад" Width="75" Height="30" Margin="10" Click="btnBack_Click"/>
        </Grid>

        <Frame x:Name="FrmMain" Grid.Row="1" />
    </Grid>
</Window> 
    
   
    